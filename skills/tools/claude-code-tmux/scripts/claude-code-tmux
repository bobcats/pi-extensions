#!/usr/bin/env python3
"""Drive the interactive Claude Code CLI through an isolated tmux session."""

from __future__ import annotations

import argparse
import json
import os
from pathlib import Path
import random
import re
import shlex
import shutil
import string
import subprocess
import sys
import tempfile
import time
from typing import Any


ANSI_RE = re.compile(r"\x1b\[[0-?]*[ -/]*[@-~]")
DEFAULT_CLAUDE_TOOLS = "Read,Edit,MultiEdit,Write,Glob,Grep,LS,TodoWrite"


def slug(value: str, max_len: int = 40) -> str:
    cleaned = re.sub(r"[^a-zA-Z0-9_.-]+", "-", value).strip("-.")
    return (cleaned[:max_len].strip("-.") or "run").lower()


def make_session_name() -> str:
    suffix = "".join(random.choice(string.ascii_lowercase + string.digits) for _ in range(6))
    return f"bcc-{int(time.time())}-{os.getpid()}-{suffix}"


def strip_ansi(text: str) -> str:
    return ANSI_RE.sub("", text)


class TmuxRunner:
    def __init__(self, tmux_command: str, socket: Path, session: str):
        self.tmux_command = tmux_command
        self.socket = socket
        self.session = session

    def run(self, args: list[str], *, check: bool = True) -> subprocess.CompletedProcess[str]:
        command = [self.tmux_command, "-S", str(self.socket), *args]
        return subprocess.run(command, text=True, capture_output=True, check=check)

    def capture(self, lines: int, *, plain: bool) -> str:
        result = self.run(["capture-pane", "-pt", self.session, "-S", f"-{lines}"], check=False)
        text = result.stdout
        return strip_ansi(text) if plain else text

    def kill(self) -> None:
        self.run(["kill-session", "-t", self.session], check=False)


def read_task(task_arg: str | None) -> str:
    if task_arg is not None:
        task = task_arg.strip()
    elif not sys.stdin.isatty():
        task = sys.stdin.read().strip()
    else:
        raise SystemExit("Provide --task or pipe a task on stdin.")

    if not task:
        raise SystemExit("Task is empty.")
    return task


def build_prompt(task: str, sentinel: str | None) -> str:
    if sentinel is None:
        return task
    return (
        f"{task.rstrip()}\n\n"
        "When you are completely finished with your final response, print this exact completion marker on its own line:\n"
        f"{sentinel}"
    )


def ensure_executable(name: str, description: str) -> None:
    if shutil.which(name) is None:
        raise SystemExit(f"Required {description} not found on PATH: {name}")


def build_claude_launch_command(base_command: str) -> str:
    parts = shlex.split(base_command.strip() or "claude") or ["claude"]
    enforced_args = [
        "--dangerously-skip-permissions",
        "--tools",
        DEFAULT_CLAUDE_TOOLS,
        "--allowedTools",
        DEFAULT_CLAUDE_TOOLS,
    ]
    return " ".join(shlex.quote(part) for part in [*parts, *enforced_args])


def start_tmux_session(runner: TmuxRunner, cwd: Path) -> None:
    runner.socket.parent.mkdir(parents=True, exist_ok=True)
    runner.run(["new-session", "-d", "-s", runner.session, "-n", "claude", "-c", str(cwd)])


def paste_prompt(runner: TmuxRunner, prompt: str) -> None:
    with tempfile.NamedTemporaryFile("w", encoding="utf-8", delete=False) as prompt_file:
        prompt_file.write(prompt)
        prompt_path = Path(prompt_file.name)
    try:
        runner.run(["load-buffer", "-b", "claude-code-tmux-prompt", str(prompt_path)])
        runner.run(["paste-buffer", "-b", "claude-code-tmux-prompt", "-t", runner.session, "-d"])
        runner.run(["send-keys", "-t", runner.session, "C-m"])
    finally:
        try:
            prompt_path.unlink()
        except FileNotFoundError:
            pass


def wait_for_completion(
    runner: TmuxRunner,
    *,
    sentinel: str | None,
    timeout_seconds: float,
    poll_seconds: float,
    capture_lines: int,
    plain: bool,
) -> tuple[str, bool]:
    deadline = time.monotonic() + timeout_seconds
    transcript = ""

    while time.monotonic() < deadline:
        transcript = runner.capture(capture_lines, plain=plain)
        if sentinel is not None and sentinel in transcript:
            time.sleep(min(1.0, poll_seconds))
            transcript = runner.capture(capture_lines, plain=plain)
            return transcript, True
        time.sleep(poll_seconds)

    transcript = runner.capture(capture_lines, plain=plain)
    return transcript, False


def result_payload(**kwargs: Any) -> dict[str, Any]:
    return kwargs


def emit_result(payload: dict[str, Any], *, json_output: bool) -> None:
    if json_output:
        print(json.dumps(payload, indent=2, sort_keys=True))
        return

    status = payload.get("status", "unknown")
    print(f"claude-code-tmux: {status}")
    print(f"session: {payload.get('session')}")
    print(f"socket: {payload.get('socket')}")
    if payload.get("keptOpen"):
        print("kept open: true")
    if payload.get("error"):
        print(f"error: {payload['error']}", file=sys.stderr)
    transcript = payload.get("transcript")
    if transcript:
        print("\n--- transcript ---")
        print(transcript.rstrip())


def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--task", help="Task prompt to send to Claude Code. If omitted, stdin is used.")
    parser.add_argument("--cwd", default=".", help="Working directory for the Claude Code tmux session. Default: current directory.")
    parser.add_argument("--timeout", type=float, default=1800, help="Seconds to wait for the completion marker. Default: 1800.")
    parser.add_argument("--poll", type=float, default=1.0, help="Seconds between pane captures. Default: 1.")
    parser.add_argument("--startup-delay", type=float, default=3.0, help="Seconds to wait after launching Claude before pasting. Default: 3.")
    parser.add_argument("--capture-lines", type=int, default=2000, help="Pane lines to capture for transcript. Default: 2000.")
    parser.add_argument("--session", help="tmux session name. Default: generated unique name.")
    parser.add_argument("--socket", help="tmux socket path. Default: temp private socket.")
    parser.add_argument("--tmux-command", default="tmux", help="tmux executable name/path. Default: tmux.")
    parser.add_argument("--claude-command", default=os.environ.get("CLAUDE_CODE_COMMAND", "claude"), help="Claude Code executable/leading args sent inside tmux. Safety flags are always appended: --dangerously-skip-permissions plus a constrained built-in tool set.")
    parser.add_argument("--sentinel", help="Completion marker. Default: generated unique marker.")
    parser.add_argument("--no-sentinel", action="store_true", help="Do not append a completion-marker instruction; wait until timeout.")
    parser.add_argument("--keep-open", action="store_true", help="Leave the tmux session running after the script exits.")
    parser.add_argument("--json", action="store_true", help="Emit machine-readable JSON.")
    parser.add_argument("--no-plain", action="store_true", help="Do not strip ANSI escape sequences from captured transcript.")
    return parser.parse_args(argv)


def main(argv: list[str]) -> int:
    args = parse_args(argv)
    task = read_task(args.task)
    cwd = Path(args.cwd).expanduser().resolve()
    if not cwd.is_dir():
        raise SystemExit(f"Working directory does not exist or is not a directory: {cwd}")

    ensure_executable(args.tmux_command, "tmux command")

    claude_parts = shlex.split(args.claude_command.strip() or "claude") or ["claude"]
    ensure_executable(claude_parts[0], "Claude Code command")
    claude_launch_command = build_claude_launch_command(args.claude_command)

    session = args.session or make_session_name()
    # tmux socket paths are Unix-domain socket paths and must stay short on macOS.
    socket_dir = Path(os.environ.get("BOBCATS_TMUX_SOCKET_DIR", "/tmp/bccct"))
    socket = Path(args.socket).expanduser() if args.socket else socket_dir / f"{slug(session, 32)}.sock"
    sentinel = None if args.no_sentinel else (args.sentinel or f"BOBCATS_CLAUDE_CODE_TMUX_DONE_{int(time.time())}_{os.getpid()}")
    prompt = build_prompt(task, sentinel)
    runner = TmuxRunner(args.tmux_command, socket, session)
    kept_open = False

    try:
        start_tmux_session(runner, cwd)
        runner.run(["send-keys", "-t", session, claude_launch_command, "C-m"])
        time.sleep(max(0.0, args.startup_delay))
        paste_prompt(runner, prompt)
        transcript, completed = wait_for_completion(
            runner,
            sentinel=sentinel,
            timeout_seconds=max(0.1, args.timeout),
            poll_seconds=max(0.1, args.poll),
            capture_lines=max(1, args.capture_lines),
            plain=not args.no_plain,
        )
        status = "completed" if completed else "timeout"
        exit_code = 0 if completed else 124
    except subprocess.CalledProcessError as error:
        transcript = runner.capture(max(1, args.capture_lines), plain=not args.no_plain) if socket.exists() else ""
        payload = result_payload(
            ok=False,
            status="failed",
            error=(error.stderr or error.stdout or str(error)).strip(),
            session=session,
            socket=str(socket),
            cwd=str(cwd),
            claudeCommand=claude_launch_command,
            allowedTools=DEFAULT_CLAUDE_TOOLS,
            sentinel=sentinel,
            keptOpen=False,
            transcript=transcript,
        )
        if args.keep_open:
            kept_open = True
            payload["keptOpen"] = True
        else:
            runner.kill()
        emit_result(payload, json_output=args.json)
        return 1
    else:
        if args.keep_open:
            kept_open = True
        else:
            runner.kill()

        payload = result_payload(
            ok=completed,
            status=status,
            session=session,
            socket=str(socket),
            cwd=str(cwd),
            claudeCommand=claude_launch_command,
            allowedTools=DEFAULT_CLAUDE_TOOLS,
            sentinel=sentinel,
            keptOpen=kept_open,
            transcript=transcript,
        )
        emit_result(payload, json_output=args.json)
        return exit_code


if __name__ == "__main__":
    try:
        raise SystemExit(main(sys.argv[1:]))
    except SystemExit as error:
        raise error
    except Exception as error:  # pragma: no cover - defensive CLI boundary
        print(f"claude-code-tmux failed: {error}", file=sys.stderr)
        raise SystemExit(1)
